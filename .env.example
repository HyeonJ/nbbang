# PROD_DATABASE_URL은 의도적으로 여기 없다 — 프로덕션 자격증명은 로컬에 두지 않고
# GitHub Secrets(CI deploy 잡)와 Vercel 환경변수에만 둔다.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
BETTER_AUTH_SECRET=openssl-rand-32
BETTER_AUTH_URL=http://localhost:3000

# 공개 장부 레이트 리밋의 IP 해시 salt (Plan 04 Task 1).
# 없으면 /g/ 미들웨어가 시작 시 던진다 — 기본값을 하드코딩하지 않는다(글로벌 규칙).
# 이 값이 바뀌면 기존 카운터 버킷이 전부 새 키로 갈려 제한이 한 번 리셋된다(무해).
#   openssl rand -hex 32
RATE_LIMIT_SALT=openssl-rand-hex-32

# CRON_SECRET은 의도적으로 여기 없다 — 정리 크론(/api/cron/cleanup)은 Vercel이 호출하므로
# 프로덕션 Vercel 환경변수에만 둔다. 로컬에 없으면 그 라우트는 항상 401이다(그게 맞는 동작).

# .env.test의 DATABASE_URL은 반드시 E2E 전용 Neon 브랜치여야 한다 (global-setup이 TRUNCATE 한다).
# 새 테스트 브랜치에서는 마커 테이블을 1회 생성 (drizzle-kit이 관리하지 않는 별도 스키마에 둔다):
#   create schema if not exists e2e_guard;
#   create table if not exists e2e_guard.sentinel();
